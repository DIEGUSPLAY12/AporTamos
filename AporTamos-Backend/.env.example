# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/aporTamos
SQLALCHEMY_ECHO=false

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# App Configuration
APP_NAME=AporTamos
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8081", "http://localhost:19000", "http://localhost:19001"]

# Storage Configuration
MAX_PHOTO_SIZE=5242880  # 5MB in bytes
PHOTO_BUCKET_NAME=task-proofs
CHAT_BUCKET_NAME=chat-media

# Email Configuration (if applicable)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDER_EMAIL=noreply@aportamos.com

# Security
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

